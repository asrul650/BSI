# Salin ke backend/.env dan isi nilainya sendiri. Jangan commit backend/.env.
# File ini hanya berisi NAMA variabel, tidak ada nilai/secret.

# --- Database (wajib) ---
# Connection string Postgres. Tidak ada default/fallback -- aplikasi
# berhenti (fail closed) kalau ini kosong.
DATABASE_URL=
# Dipakai oleh docker-compose.yml untuk container Postgres lokal.
# Harus sama dengan password di DATABASE_URL di atas.
POSTGRES_PASSWORD=

# --- OTP WhatsApp (wajib) ---
FONNTE_TOKEN=
# Opsional, default https://api.fonnte.com/send kalau kosong.
FONNTE_BASE_URL=
# Kunci HMAC untuk hash nomor HP/IP/kode OTP yang disimpan di DB.
OTP_HASH_SECRET=
# Kunci HMAC terpisah untuk token verifikasi OTP.
OTP_VERIFICATION_SECRET=

# --- Sesi staf (F-01) ---
# "true" (default kalau kosong) = cookie sesi Secure. Set eksplisit
# "false" hanya untuk dev lokal di http://localhost (bukan https).
COOKIE_SECURE=

# Origin frontend yang diizinkan CORS. Default http://localhost:5173
# kalau kosong.
ALLOWED_ORIGIN=

# --- Dev tooling ---
# Harus "dev" supaya backend/cmd/seed mau jalan. Jangan pernah diisi "dev"
# di lingkungan produksi.
APP_ENV=
